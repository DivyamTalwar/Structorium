# Structorium AI stack
# Copy to .env and fill in secrets.

STRUCTORIUM_AI_ENABLED=1
STRUCTORIUM_AI_INCLUDE_IN_REVIEW=1

OPENAI_API_KEY=
STRUCTORIUM_EMBEDDING_MODEL=text-embedding-3-large
STRUCTORIUM_EMBEDDING_DIMENSIONS=

COHERE_API_KEY=

TURBOPUFFER_API_KEY=
TURBOPUFFER_NAMESPACE=structorium-code
TURBOPUFFER_REGION=

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

STRUCTORIUM_AI_RETRIEVAL_TOP_K=24
STRUCTORIUM_AI_RERANK_TOP_N=10
STRUCTORIUM_AI_CHUNK_CHARS=1800
STRUCTORIUM_AI_CHUNK_OVERLAP_CHARS=240
